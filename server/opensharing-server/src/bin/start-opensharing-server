#!/usr/bin/env bash
# Starts the server from the unpacked tarball. Files in etc/conf take precedence over the copies
# in the jars, and JAVA_OPTS passes JVM options such as -Dserver.port=9090.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# JAVA_OPTS is left unquoted so that it splits into separate options.
# shellcheck disable=SC2086
exec java ${JAVA_OPTS:-} -cp "$ROOT_DIR/etc/conf:$ROOT_DIR/jars/*" \
  io.opensharing.OpenSharingServer "$@"
